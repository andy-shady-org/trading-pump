<?xml version="1.0" encoding="UTF-8"?>
<!--
  pumpbot as a macOS launchd user agent (Sprint 24D). See docs/dev/RUNBOOK.md §8.

  Install:  replace /Users/CHANGE_ME below, then
            cp deploy/launchd/com.pumpfun.pumpbot.plist ~/Library/LaunchAgents/
            launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.pumpfun.pumpbot.plist
  Pause:    kill -USR1 $(launchctl print gui/$(id -u)/com.pumpfun.pumpbot | awk '/pid =/ {print $3}')
  Stop:     launchctl bootout gui/$(id -u)/com.pumpfun.pumpbot   (SIGTERM, graceful)

  KeepAlive restarts the bot whenever it exits (pumpbot exits 1 when its stream
  loop ends without a shutdown request); bootout stops it for good.
  ThrottleInterval spaces restarts at least 30 s apart.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.pumpfun.pumpbot</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/CHANGE_ME/projects/git/trading/runtime/pumpbot-run.sh</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/CHANGE_ME/projects/git/trading/runtime</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PUMPBOT_RUNTIME_DIR</key>
    <string>/Users/CHANGE_ME/projects/git/trading/runtime</string>
    <key>PUMPBOT_BIN</key>
    <string>/Users/CHANGE_ME/projects/git/trading/runtime/.venv/bin/pumpbot</string>
    <key>PUMPBOT_CONFIG</key>
    <string>configs/canary.json</string>
    <!-- Stage 0 paper pilot; remove "paper-trade" for the live canary. -->
    <key>PUMPBOT_EXTRA_ARGS</key>
    <string>--paper-trade --record-replay data/replay_capture.jsonl</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>30</integer>
  <key>ExitTimeOut</key>
  <integer>60</integer>
  <key>Umask</key>
  <integer>63</integer>
  <key>StandardOutPath</key>
  <string>/Users/CHANGE_ME/projects/git/trading/runtime/data/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/CHANGE_ME/projects/git/trading/runtime/data/launchd.err.log</string>
</dict>
</plist>
