# pumpbot under systemd (Linux), Sprint 24D. See docs/dev/RUNBOOK.md §8.
#
# Install:   sudo cp deploy/systemd/pumpbot.service /etc/systemd/system/
#            sudo systemctl daemon-reload && sudo systemctl enable --now pumpbot
# Pause:     sudo systemctl kill -s USR1 pumpbot   (toggles; exits keep running)
# Stop:      sudo systemctl stop pumpbot           (SIGTERM, graceful shutdown)
# Logs:      journalctl -u pumpbot -f              (plus data/bot.log)
#
# Adjust User, the paths and PUMPBOT_EXTRA_ARGS (paper vs live) before enabling.

[Unit]
Description=pumpbot headless trading bot
Wants=network-online.target
After=network-online.target
# Give up after 5 starts in 30 min: a crash loop must not keep trading (or
# spamming alerts); the "bot started" alerts show each restart.
StartLimitIntervalSec=1800
StartLimitBurst=5

[Service]
Type=simple
User=pumpbot
Group=pumpbot
WorkingDirectory=/opt/pumpbot/runtime
Environment=PUMPBOT_RUNTIME_DIR=/opt/pumpbot/runtime
Environment=PUMPBOT_BIN=/opt/pumpbot/venv/bin/pumpbot
Environment=PUMPBOT_CONFIG=configs/canary.json
# Stage 0 paper pilot; remove --paper-trade for the live canary (Stage 1).
Environment="PUMPBOT_EXTRA_ARGS=--paper-trade --record-replay data/replay_capture.jsonl"
ExecStart=/opt/pumpbot/runtime/pumpbot-run.sh
Restart=always
RestartSec=15
# A missing .envrc (exit 78) is a config error, not a crash.
RestartPreventExitStatus=78
KillSignal=SIGTERM
TimeoutStopSec=60

# Hardening: the bot only writes inside its runtime directory.
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/pumpbot/runtime
MemoryMax=1G
LimitNOFILE=8192

StandardOutput=journal
StandardError=journal
SyslogIdentifier=pumpbot

[Install]
WantedBy=multi-user.target
